# A CRLF in a shell script makes the shebang `/usr/bin/env bash\r`, and Linux reports
# "bad interpreter: no such file or directory" - which reads like bash is missing. The repo is
# edited on Windows, so without this admin.sh is committed with CRLF and fails on the platform
# it exists for.
*.sh text eol=lf

# Generated by scripts/compact-policies.mjs with LF endings; tests/policy-size.test.mjs compares them
# byte for byte, so a CRLF checkout must not rewrite them.
infra/*.min.xml text eol=lf
