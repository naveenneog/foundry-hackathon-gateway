<mxfile host="app.diagrams.net" compressed="false">
  <diagram id="request-network" name="Request and network">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"></mxCell>
        <mxCell id="1" parent="0"></mxCell>
        <mxCell id="title" value="APIM PRODUCTS + KEY VAULT | REQUEST AND NETWORK" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Existing Standard v2 POC | Key Vault distributes APIM keys; it is not on the inference request path." style="text;html=1;align=left;fontSize=16;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="1500" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="client" value="&lt;b&gt;1. CLIENT&lt;/b&gt;&lt;br&gt;Claude Code / Anthropic SDK&lt;br&gt;opencode / OpenAI SDK / curl&lt;br&gt;&lt;br&gt;/poc/claude : x-api-key&lt;br&gt;/poc/v1 : api-key&lt;br&gt;HTTPS to public gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE4FA;strokeColor=#0078D4;fontColor=#000000;fontSize=16;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="300" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="apim" value="&lt;b&gt;2. API MANAGEMENT | Standard v2&lt;/b&gt;&lt;br&gt;Key -&gt; subscription -&gt; product pack&lt;br&gt;&lt;br&gt;&lt;b&gt;Product policy (first)&lt;/b&gt;&lt;br&gt;Model allowlist; monthly per-key budget&lt;br&gt;Per-key TPM; monthly product pool&lt;br&gt;Counter: context.Subscription.Id&lt;br&gt;&lt;br&gt;&lt;b&gt;Route policy&lt;/b&gt;&lt;br&gt;Require product; remove key headers&lt;br&gt;Managed identity -&gt; Authorization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#5C2D91;fontColor=#000000;fontSize=16;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="130" width="390" height="320" as="geometry"/>
        </mxCell>
        <mxCell id="foundry-pe" value="&lt;b&gt;3. FOUNDRY&lt;br&gt;PRIVATE ENDPOINT&lt;/b&gt;&lt;br&gt;Private DNS&lt;br&gt;VNet integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#000000;fontSize=16;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="200" width="240" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="foundry" value="&lt;b&gt;4. MICROSOFT FOUNDRY&lt;/b&gt;&lt;br&gt;Existing model deployments&lt;br&gt;Claude / DeepSeek&lt;br&gt;public access Disabled&lt;br&gt;&lt;br&gt;APIM managed identity:&lt;br&gt;Cognitive Services User&lt;br&gt;Audience: https://ai.azure.com&lt;br&gt;No Foundry key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#000000;fontSize=16;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1210" y="150" width="330" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="request" value="Request + key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#0078D4;strokeWidth=2;fontColor=#000000;fontSize=14;" edge="1" parent="1" source="client" target="apim">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="backend" value="Outbound VNet" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#107C10;strokeWidth=2;fontColor=#000000;fontSize=14;" edge="1" parent="1" source="apim" target="foundry-pe">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="inference" value="Inference" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#107C10;strokeWidth=2;fontColor=#000000;fontSize=14;" edge="1" parent="1" source="foundry-pe" target="foundry">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="response" value="Response returns along the request path; tokens counted against both budgets; x-budget-remaining returned. Probe: /poc/probe/whoami, no backend or token use." style="text;html=1;whiteSpace=wrap;align=left;fontColor=#000000;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="900" y="420" width="640" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="operator" value="&lt;b&gt;OPERATOR&lt;/b&gt;&lt;br&gt;PowerShell + Azure CLI tokens&lt;br&gt;Provision / Grant / Revoke&lt;br&gt;Suspend / Resume / SetExpiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#F7630C;fontColor=#000000;fontSize=16;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="300" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="arm" value="&lt;b&gt;AZURE RESOURCE MANAGER&lt;/b&gt;&lt;br&gt;Public management endpoint&lt;br&gt;management.azure.com&lt;br&gt;Subscription actions + RBAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#F7630C;fontColor=#000000;fontSize=16;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="510" width="390" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="subscriptions" value="&lt;b&gt;APIM CONFIGURATION&lt;/b&gt;&lt;br&gt;Products: poc-claude-pack / poc-deepseek-pack / poc-tiny-pack&lt;br&gt;Subscriptions: poc-&amp;lt;name&amp;gt;, scoped to ONE pack&lt;br&gt;Primary + secondary keys; active / suspended; stored expiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#5C2D91;fontColor=#000000;fontSize=16;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="900" y="510" width="640" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="management" value="Management" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#F7630C;strokeWidth=2;fontColor=#000000;fontSize=14;" edge="1" parent="1" source="operator" target="arm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="configure" value="Create / update" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#F7630C;strokeWidth=2;fontColor=#000000;fontSize=14;" edge="1" parent="1" source="arm" target="subscriptions">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="private-band" value="" style="rounded=1;html=1;fillColor=none;strokeColor=#107C10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="680" width="1540" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="private-label" value="PRIVATE SECRET ACCESS | privatelink.vaultcore.azure.net&lt;br&gt;Network reachability AND Entra ID / RBAC required" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#000000;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="540" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="helper" value="&lt;b&gt;DEVELOPER apiKeyHelper&lt;/b&gt;&lt;br&gt;Machine on private network&lt;br&gt;Entra sign-in + Secrets User&lt;br&gt;Scope: own secret only&lt;br&gt;Read current key for Claude Code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE4FA;strokeColor=#0078D4;fontColor=#000000;fontSize=16;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="300" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="runner" value="&lt;b&gt;RUNNER VM / KEY SCRIPTS&lt;/b&gt;&lt;br&gt;Private subnet; no public IP&lt;br&gt;Run Command; outbound NAT&lt;br&gt;MI: Secrets Officer (vault)&lt;br&gt;APIM Contributor (instance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#F7630C;fontColor=#000000;fontSize=16;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="760" width="390" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="vault-pe" value="&lt;b&gt;VAULT PRIVATE ENDPOINT&lt;/b&gt;&lt;br&gt;snet-pe&lt;br&gt;Created by runner Deploy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#000000;fontSize=16;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="900" y="780" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="vault" value="&lt;b&gt;AZURE KEY VAULT&lt;/b&gt;&lt;br&gt;poc-key-&amp;lt;name&amp;gt;: current key&lt;br&gt;Versions; slot / subscription / product&lt;br&gt;Azure RBAC; public access Disabled&lt;br&gt;Default Deny; bypass: None&lt;br&gt;Optional audit -&gt; Log Analytics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#000000;fontSize=16;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1210" y="740" width="330" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="helper-read" value="SecretGet" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#107C10;strokeWidth=2;fontColor=#000000;fontSize=14;exitX=1;exitY=1;entryX=0;entryY=1;" edge="1" parent="1" source="helper" target="vault-pe">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="925"/><mxPoint x="870" y="925"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="runner-secrets" value="Read / write" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#107C10;strokeWidth=2;fontColor=#000000;fontSize=14;" edge="1" parent="1" source="runner" target="vault-pe">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="vault-data" value="TLS" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#107C10;strokeWidth=2;fontColor=#000000;fontSize=14;" edge="1" parent="1" source="vault-pe" target="vault">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="runner-arm" value="APIM key actions" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#F7630C;strokeWidth=2;fontColor=#000000;fontSize=14;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="runner" target="arm">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="limits" value="&lt;b&gt;POC LIMITS&lt;/b&gt; | Budgets reconcile across gateway nodes: small quotas can overshoot. Expiry needs scheduled SuspendExpired (page 2).&lt;br&gt;Key headers are removed, but subscription-key query values still reach Foundry (P42). Internet clients using a handed-out key need no vault path.&lt;br&gt;Sources: ARCHITECTURE.md (Request flow, Network paths, Measured behaviour); README.md results; docs/UNKNOWNS.md U23-U30. Branch only; not main." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#F7630C;fontColor=#000000;fontSize=15;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="970" width="1500" height="100" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="key-lifecycle" name="Key lifecycle">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"></mxCell>
        <mxCell id="1" parent="0"></mxCell>
        <mxCell id="title" value="APIM PRODUCTS + KEY VAULT | KEY LIFECYCLE" style="text;html=1;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1500" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="APIM owns the subscription and two keys. Key Vault publishes the current client key. Scripts orchestrate both services." style="text;html=1;align=left;fontSize=16;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="1500" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="issue-label" value="A. ISSUE | Operator / private-network runner" style="text;html=1;align=left;fontColor=#000000;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1500" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="create" value="&lt;b&gt;1. APIM: CREATE SUBSCRIPTION&lt;/b&gt;&lt;br&gt;poc-&amp;lt;name&amp;gt;&lt;br&gt;Scope: /products/&amp;lt;pack&amp;gt;&lt;br&gt;State: active&lt;br&gt;Primary + secondary keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#5C2D91;fontColor=#000000;fontSize=17;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="420" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="list" value="&lt;b&gt;2. SCRIPT: LIST APIM KEYS&lt;/b&gt;&lt;br&gt;POST listSecrets (management API)&lt;br&gt;Select primary key&lt;br&gt;Keep key in memory&lt;br&gt;Do not print or write to disk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#F7630C;fontColor=#000000;fontSize=17;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="180" width="420" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="store" value="&lt;b&gt;3. VAULT: STORE CURRENT KEY&lt;/b&gt;&lt;br&gt;poc-key-&amp;lt;name&amp;gt; = primary&lt;br&gt;Tags: slot=primary,&lt;br&gt;subscription, product&lt;br&gt;Private endpoint + RBAC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#000000;fontSize=17;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1120" y="180" width="420" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="issue-read" value="Read keys" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#F7630C;strokeWidth=2;fontColor=#000000;fontSize=15;" edge="1" parent="1" source="create" target="list">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="issue-store" value="SecretSet" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#107C10;strokeWidth=2;fontColor=#000000;fontSize=15;" edge="1" parent="1" source="list" target="store">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="handover" value="&lt;b&gt;HAND OVER&lt;/b&gt; | Grant: Secrets User on ONE secret via ARM. Developer apiKeyHelper reads the latest version over a private path.&lt;br&gt;Alternative: operator hands over a one-time copy; it works until the slot is regenerated on the next rotation after the first switch." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE4FA;strokeColor=#0078D4;fontColor=#000000;fontSize=16;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="365" width="1500" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="rotate-label" value="B. ROTATE | Explicit script action; No automatic Key Vault rotation job is deployed" style="text;html=1;align=left;fontColor=#000000;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="1500" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="read-slot" value="&lt;b&gt;1. VAULT: READ CURRENT SLOT&lt;/b&gt;&lt;br&gt;GET poc-key-&amp;lt;name&amp;gt;&lt;br&gt;slot=primary -&gt; use secondary&lt;br&gt;slot=secondary -&gt; use primary&lt;br&gt;Missing slot: stop before regeneration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#000000;fontSize=17;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="520" width="420" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="regenerate" value="&lt;b&gt;2. APIM: REGENERATE INACTIVE SLOT&lt;/b&gt;&lt;br&gt;regenerateSecondaryKey (if primary held)&lt;br&gt;or regeneratePrimaryKey&lt;br&gt;Then listSecrets&lt;br&gt;Clients' current slot is unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#5C2D91;fontColor=#000000;fontSize=17;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="520" width="420" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="publish" value="&lt;b&gt;3. VAULT: PUBLISH NEXT KEY&lt;/b&gt;&lt;br&gt;Write new secret version&lt;br&gt;Update slot tag; retain subscription/product&lt;br&gt;apiKeyHelper picks up current version&lt;br&gt;Old held key works until next rotation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DFF6DD;strokeColor=#107C10;fontColor=#000000;fontSize=17;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1120" y="520" width="420" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="rotate-select" value="inactive slot" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#F7630C;strokeWidth=2;fontColor=#000000;fontSize=15;" edge="1" parent="1" source="read-slot" target="regenerate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rotate-publish" value="SecretSet" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#107C10;strokeWidth=2;fontColor=#000000;fontSize=15;" edge="1" parent="1" source="regenerate" target="publish">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="rotation-note" value="&lt;b&gt;Same subscription -&gt; same counter -&gt; budget survives rotation.&lt;/b&gt; No Foundry key to rotate; APIM uses its managed identity.&lt;br&gt;Key changes propagate asynchronously across nodes. The current client key is not invalidated by the first switch.&lt;br&gt;Security: listSecrets permission at the APIM instance can expose every subscription key, including all-access." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F2F1;strokeColor=#666666;fontColor=#000000;fontSize=16;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="705" width="1500" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="control-label" value="C. ACCESS AND EXPIRY | Management-plane actions; no vault data-plane path required" style="text;html=1;align=left;fontColor=#000000;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="1500" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="expiry" value="&lt;b&gt;EXPIRY&lt;/b&gt;&lt;br&gt;SetExpiry stores a date in APIM&lt;br&gt;Date alone: not enforced by gateway&lt;br&gt;Schedule SuspendExpired yourself&lt;br&gt;Suspend from 00:00 UTC on that date" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4CE;strokeColor=#F7630C;fontColor=#000000;fontSize=17;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="420" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="suspend" value="&lt;b&gt;Suspend / Resume&lt;/b&gt;&lt;br&gt;Change APIM subscription state&lt;br&gt;Suspended key -&gt; 401 after propagation&lt;br&gt;Both key slots share that state&lt;br&gt;Key values and vault secret unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8DAEF;strokeColor=#5C2D91;fontColor=#000000;fontSize=17;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="860" width="420" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="revoke" value="&lt;b&gt;Revoke SECRET READ ACCESS&lt;/b&gt;&lt;br&gt;Remove exact per-secret role assignment&lt;br&gt;Does NOT invalidate a copied APIM key&lt;br&gt;Use Suspend to stop gateway access&lt;br&gt;Wider RBAC roles remain unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE4FA;strokeColor=#0078D4;fontColor=#000000;fontSize=17;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="1120" y="860" width="420" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="sources" value="Sources: ARCHITECTURE.md (Key lifecycle, Identities and roles); scripts/PocKeys.ps1; README.md measured results; docs/UNKNOWNS.md U24-U28, U30." style="text;html=1;whiteSpace=wrap;align=left;fontColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="1030" width="1500" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
