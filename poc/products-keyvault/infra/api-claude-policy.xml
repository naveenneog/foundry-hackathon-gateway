<!--
    P37 proof of concept: the Claude route, the Anthropic Messages API on Foundry. Callers send
    an API Management subscription key in x-api-key, which is where Claude Code sends
    ANTHROPIC_API_KEY and the output of apiKeyHelper.
-->
<policies>
    <inbound>
        <!-- First, so the product's pack and budgets apply before anything else. -->
        <base />
        <!-- A key that is not issued on a product skipped every product policy above, budgets
             included. Refuse it (UNKNOWNS U26). -->
        <choose>
            <when condition="@(context.Product == null)">
                <return-response>
                    <set-status code="403" reason="Forbidden" />
                    <set-header name="Content-Type" exists-action="override">
                        <value>application/json</value>
                    </set-header>
                    <set-body>{"type":"error","error":{"type":"permission_error","message":"product_required: this key is not issued on a product, so no budget applies to it."}}</set-body>
                </return-response>
            </when>
        </choose>
        <!-- Foundry is called with the gateway's managed identity, and the caller's key stops
             here: API Management forwards it to the backend unless a policy removes it. -->
        <authentication-managed-identity
            resource="https://ai.azure.com"
            output-token-variable-name="msi-token"
            ignore-error="false" />
        <set-header name="Authorization" exists-action="override">
            <value>@("Bearer " + (string)context.Variables["msi-token"])</value>
        </set-header>
        <set-header name="x-api-key" exists-action="delete" />
        <set-header name="api-key" exists-action="delete" />
        <set-header name="anthropic-version" exists-action="skip">
            <value>2023-06-01</value>
        </set-header>
    </inbound>
    <backend>
        <base />
    </backend>
    <outbound>
        <base />
    </outbound>
    <on-error>
        <base />
    </on-error>
</policies>
